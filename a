-- ─── Auto Heal System ──────────────────────────────────────────────────────────
local function stopAnimations()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        track:Stop(0)
    end
end

local function getHealthTool()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("HealthRestoreAmount") then
                return tool
            end
        end
    end
    if LocalPlayer.Character then
        for _, tool in pairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("HealthRestoreAmount") then
                return tool
            end
        end
    end
    return nil
end

local function useHealthTool(tool)
    if healBusy then return end
    if tick() - lastUse < COOLDOWN then return end
    healBusy = true
    lastUse = tick()
    local char = LocalPlayer.Character
    if not char then healBusy = false; return end
    local oldTool = char:FindFirstChildOfClass("Tool")
    tool.Parent = char
    task.wait()
    tool:Activate()
    stopAnimations()
    task.wait(0.25)
    if oldTool and oldTool.Parent == char then
        oldTool.Parent = LocalPlayer.Backpack
    end
    healBusy = false
end

task.spawn(function()
    while true do
        task.wait(CHECK_DELAY == 0 and 0.1 or CHECK_DELAY)
        if autoHealEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                local hum = char.Humanoid
                if hum.Health < HEALTH_THRESHOLD then
                    local tool = getHealthTool()
                    if tool then useHealthTool(tool) end
                end
            end
        end
    end
end)

-- ─── ESP System ────────────────────────────────────────────────────────────────
local function createESP(player)
    if espPlayers[player] then return end
    local nameText = Drawing.new("Text")
    nameText.Size = 16; nameText.Center = true; nameText.Outline = true
    nameText.Color = Color3.fromRGB(255,255,255); nameText.Font = 4; nameText.Visible = false

    local distText = Drawing.new("Text")
    distText.Size = 13; distText.Center = true; distText.Outline = true
    distText.Color = Color3.fromRGB(200,200,200); distText.Font = 4; distText.Visible = false

    local healthBg = Drawing.new("Square")
    healthBg.Filled = true; healthBg.Color = Color3.fromRGB(0,0,0)
    healthBg.Transparency = 0; healthBg.Visible = false

    local healthFg = Drawing.new("Square")
    healthFg.Filled = true; healthFg.Transparency = 0; healthFg.Visible = false

    local healthOutline = Drawing.new("Square")
    healthOutline.Filled = false; healthOutline.Thickness = 1
    healthOutline.Color = Color3.fromRGB(255,255,255); healthOutline.Transparency = 0; healthOutline.Visible = false

    local drawings = {nameText, distText, healthBg, healthFg, healthOutline}

    local conn = RunService.RenderStepped:Connect(function()
        if not player or not player.Character then
            for _, d in pairs(drawings) do d.Visible = false end; return
        end
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not hrp then for _, d in pairs(drawings) do d.Visible = false end; return end

        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen or screenPos.Z <= 0 then
            for _, d in pairs(drawings) do d.Visible = false end; return
        end

        local dist = 0
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
        end

        local cx = screenPos.X

        if nameESPEnabled then
            local sz = math.clamp(42 - (42-14) * math.clamp(dist/50,0,1), 14, 42)
            nameText.Text = player.Name
            nameText.Size = math.floor(sz)
            nameText.Color = isPlayerExcluded(player.Name) and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)
            nameText.Position = Vector2.new(cx, screenPos.Y - 20)
            nameText.Visible = true
        else
            nameText.Visible = false
        end

        if healthESPEnabled and humanoid then
            local perc = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
            local bw, bh = 70, 8
            local bx = cx - bw/2
            local by = screenPos.Y + 16
            healthBg.Position = Vector2.new(bx-1, by-1); healthBg.Size = Vector2.new(bw+2, bh+2); healthBg.Visible = true
            healthFg.Position = Vector2.new(bx, by); healthFg.Size = Vector2.new(bw * perc, bh)
            healthFg.Color = Color3.fromHSV(perc * 0.333, 1, 1); healthFg.Visible = true
            healthOutline.Position = Vector2.new(bx-1, by-1); healthOutline.Size = Vector2.new(bw+2, bh+2); healthOutline.Visible = true
        else
            healthBg.Visible = false; healthFg.Visible = false; healthOutline.Visible = false
        end

        if distanceESPEnabled then
            distText.Text = string.format("%.0f m", dist)
            distText.Position = Vector2.new(cx, screenPos.Y + 28)
            distText.Visible = true
        else
            distText.Visible = false
        end
    end)

    espPlayers[player] = {conn = conn, drawings = drawings}
end

local function removeESP(player)
    if espPlayers[player] then
        for _, d in pairs(espPlayers[player].drawings) do pcall(function() d.Visible = false end) end
        pcall(function() espPlayers[player].conn:Disconnect() end)
        espPlayers[player] = nil
    end
end

-- ─── Skeleton ESP ──────────────────────────────────────────────────────────────
local skeletonConnections = {}
local skeletonJoints = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
}

local function createSkeleton(player)
    if skeletonConnections[player] then return end
    local lines = {}
    local conn = RunService.RenderStepped:Connect(function()
        if not skeletonESPEnabled or not player or not player.Character then
            for _, line in pairs(lines) do line.Visible = false end; return
        end
        local char = player.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        if not hrp or not humanoid or humanoid.Health <= 0 then
            for _, line in pairs(lines) do line.Visible = false end; return
        end
        local isTarget = (CurrentTarget == player)
        for i, jointPair in ipairs(skeletonJoints) do
            local part1 = char:FindFirstChild(jointPair[1])
            local part2 = char:FindFirstChild(jointPair[2])
            if not lines[i] then
                lines[i] = Drawing.new("Line")
                lines[i].Thickness = 1.8; lines[i].Transparency = 0.85
            end
            local line = lines[i]
            line.Color = isTarget and Color3.fromRGB(255,50,50) or Color3.fromRGB(255,255,255)
            if part1 and part2 then
                local pos1, on1 = Camera:WorldToViewportPoint(part1.Position)
                local pos2, on2 = Camera:WorldToViewportPoint(part2.Position)
                if on1 and on2 and pos1.Z > 0 and pos2.Z > 0 then
                    line.From = Vector2.new(pos1.X, pos1.Y)
                    line.To = Vector2.new(pos2.X, pos2.Y)
                    line.Visible = true
                else line.Visible = false end
            else line.Visible = false end
        end
    end)
    skeletonConnections[player] = {conn = conn, lines = lines}
end

local function removeSkeleton(player)
    if skeletonConnections[player] then
        for _, line in pairs(skeletonConnections[player].lines) do pcall(function() line:Remove() end) end
        pcall(function() skeletonConnections[player].conn:Disconnect() end)
        skeletonConnections[player] = nil
    end
end

-- ─── Box ESP ───────────────────────────────────────────────────────────────────
local boxESPEnabled = false
local BoxDrawings = {}

local function createBoxESP(player)
    if BoxDrawings[player] then return end
    local box = Drawing.new("Square")
    box.Thickness = 1.7; box.Color = Color3.fromRGB(255,255,255)
    box.Transparency = 0.82; box.Filled = false; box.Visible = false
    local conn = RunService.RenderStepped:Connect(function()
        if not boxESPEnabled or not player or not player.Character then box.Visible = false; return end
        local char = player.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChild("Humanoid")
        if not root or not head or not humanoid or humanoid.Health <= 0 then box.Visible = false; return end
        local isTarget = (CurrentTarget == player)
        box.Color = isTarget and Color3.fromRGB(255,50,50) or Color3.fromRGB(255,255,255)
        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.8,0))
        local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3.2,0))
        if headPos.Z <= 0 or legPos.Z <= 0 then box.Visible = false; return end
        local height = math.abs(headPos.Y - legPos.Y) * 1.05
        local width = height * 0.58
        box.Size = Vector2.new(width, height)
        box.Position = Vector2.new(headPos.X - width/2, headPos.Y - height * 0.05)
        box.Visible = true
    end)
    BoxDrawings[player] = {Box = box, Connection = conn}
end

local function removeBoxESP(player)
    if BoxDrawings[player] then
        pcall(function() BoxDrawings[player].Box:Remove() end)
        pcall(function() BoxDrawings[player].Connection:Disconnect() end)
        BoxDrawings[player] = nil
    end
end

-- ─── Load All ESP ──────────────────────────────────────────────────────────────
local function loadAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createESP(player); createSkeleton(player); createBoxESP(player)
        end
    end
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function()
                task.wait(0.1)
                createESP(player); createSkeleton(player); createBoxESP(player)
            end)
            createBoxESP(player)
        end
    end)
    Players.PlayerRemoving:Connect(function(player)
        removeESP(player); removeSkeleton(player); removeBoxESP(player)
    end)
end

loadAllESP()

